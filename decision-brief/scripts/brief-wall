#!/usr/bin/env python3
"""brief-wall — dress a brief in a random Omarchy wallpaper and the palette of the theme it came from.

Prints one <style id="brief-wall"> block. Paste it straight after base.css and the brief
wears that theme: the wallpaper, blurred, sits under a scrim of the theme's own ground,
every glass surface is tinted by it, and the ink is the theme's ink.

    brief-wall                      a random theme from the rolodex, then a random wallpaper from it
    brief-wall --theme tokyo-night  that theme (installed, or fetched if the rolodex names it)
    brief-wall --image PATH         that exact file (its theme is read from the path)
    brief-wall --list               the draw: every rolodex theme and where its wallpapers are
    brief-wall --json               what was picked and measured, instead of the CSS

The draw is decision-brief/theme-rolodex.txt: only themes on a live line in it are picked,
so commenting a line out takes a theme out. A rolodex theme installed here is read from disk;
any other has its colors.toml and one wallpaper fetched from its git repository into
~/.cache/brief-wall, kept under 300 MB (BRIEF_WALL_CACHE_MB) by dropping the wallpapers used
longest ago. Offline, the draw uses what is already here. Without the rolodex file, every
installed theme is in the draw.

The pick is made once, at build time, and baked in as a data URI, so the brief stays one
self-contained file and looks the same on every machine it is mailed to. The theme is
chosen first and then the wallpaper, so a theme that ships fifteen wallpapers is no more
likely than one that ships two.

Contrast is measured, not hoped for. Body text has to clear 7:1, and muted text and links
4.5:1, over the brightest tenth of the blurred wallpaper; the ink is lightened and the
scrim thickened until they do (settle() says in what order, and why). The numbers are in
the block's opening comment, so they can be checked. A light theme is turned dark (its ink becomes the ground and its paper the ink),
because the figures a brief draws are drawn for a dark page.

Needs `vips` (libvips). Standard library otherwise.
"""
import argparse, base64, json, os, random, re, subprocess, sys, tempfile
from pathlib import Path

THEME_ROOTS = [
    '/usr/share/omarchy/themes',
    os.path.expanduser('~/.local/share/omarchy/themes'),
    os.path.expanduser('~/.config/omarchy/themes'),
]
IMAGE_EXT = ('.jpg', '.jpeg', '.png', '.webp')

# The rolodex is the draw: only themes on a live line in it are picked at random. Without the
# file, every installed theme is in the draw, as before it existed.
ROLODEX = os.environ.get('BRIEF_WALL_ROLODEX') or os.path.join(
    os.path.dirname(os.path.dirname(os.path.realpath(__file__))), 'theme-rolodex.txt')
# A rolodex theme that is not installed is fetched here, one wallpaper at a time.
CACHE = os.environ.get('BRIEF_WALL_CACHE') or os.path.join(
    os.environ.get('XDG_CACHE_HOME') or os.path.expanduser('~/.cache'), 'brief-wall')
CACHE_MB = float(os.environ.get('BRIEF_WALL_CACHE_MB') or 300)

# The role names the Terminal Delight kiosk family paints with (assets/kiosk-theme.js),
# read straight out of an Omarchy colors.toml.
ROLE_KEYS = {
    'bg': 'background', 'bg2': 'lighter_background', 'bg0': 'darker_background',
    'fg': 'foreground', 'fg2': 'dark_foreground', 'fgb': 'bright_foreground',
    'acc': 'accent', 'mut': 'muted', 'sel': 'selection',
    'red': 'red', 'grn': 'green', 'yel': 'yellow', 'blu': 'blue', 'mag': 'magenta', 'cyn': 'cyan',
}

BODY_MIN, MUTED_MIN = 7.0, 4.5
# The Terminal Delight docs redesign runs its wallpaper under a scrim of 0.80, and that is the
# look this copies. 0.86 is as far as the scrim moves before the ink is asked to change.
SCRIM_START, SCRIM_SOFT, SCRIM_MAX = 0.78, 0.86, 0.93


# ---------------------------------------------------------------- colour arithmetic
def hx(s):
    s = s.strip().lstrip('#')
    if len(s) == 3:
        s = ''.join(c * 2 for c in s)
    return tuple(int(s[i:i + 2], 16) for i in (0, 2, 4))

def to_hex(c):
    return '#%02x%02x%02x' % tuple(max(0, min(255, round(v))) for v in c)

def mix(a, b, t):
    """t of a, the rest b — sRGB, the way CSS opacity and color-mix(in srgb) composite."""
    return tuple(a[i] * t + b[i] * (1 - t) for i in range(3))

def lum(c):
    def lin(v):
        v /= 255
        return v / 12.92 if v <= 0.04045 else ((v + 0.055) / 1.055) ** 2.4
    r, g, b = (lin(v) for v in c)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b

def contrast(a, b):
    la, lb = sorted((lum(a), lum(b)), reverse=True)
    return (la + 0.05) / (lb + 0.05)

WHITE, BLACK = (255, 255, 255), (0, 0, 0)


# ---------------------------------------------------------------- themes
def themes(roots=None):
    found = {}
    for root in roots or THEME_ROOTS:
        if not os.path.isdir(root):
            continue
        for name in sorted(os.listdir(root)):
            d = os.path.join(root, name)
            colors = os.path.join(d, 'colors.toml')
            bgdir = os.path.join(d, 'backgrounds')
            if not (os.path.isfile(colors) and os.path.isdir(bgdir)):
                continue
            images = sorted(os.path.join(bgdir, f) for f in os.listdir(bgdir)
                            if f.lower().endswith(IMAGE_EXT))
            if images:
                found[name] = {'name': name, 'dir': os.path.realpath(d), 'colors': colors, 'images': images}
    return found  # a user theme of the same name shadows the system one, as Omarchy does

def read_colors(path):
    vals = {}
    for line in open(path, encoding='utf-8'):
        m = re.match(r'\s*([a-z_]+)\s*=\s*"([^"]*)"', line)
        if m:
            vals[m.group(1)] = m.group(2)
    return vals

def roles_for(vals):
    """The kiosk roles, with any role the theme leaves out derived rather than invented."""
    mode = vals.get('mode', 'dark')
    get = lambda k: hx(vals[k]) if k in vals else None
    r = {role: get(key) for role, key in ROLE_KEYS.items()}
    bg = r['bg'] or BLACK
    fg = r['fg'] or WHITE
    if mode == 'light':
        # A light theme, turned dark: its ink becomes the ground and its paper the ink. Its
        # chromatic colours were chosen to sit on paper, so they are lifted until they read.
        ink = r['fg'] or BLACK
        paper = r['bg'] or WHITE
        r['bg0'], r['bg'], r['bg2'] = mix(ink, BLACK, .16), mix(ink, BLACK, .26), mix(ink, BLACK, .40)
        r['fgb'] = paper
        r['fg'] = mix(paper, ink, .86)
        r['fg2'] = mix(paper, ink, .55)
        r['mut'] = mix(paper, ink, .35)
        r['sel'] = mix(ink, BLACK, .55)
        for k in ('acc', 'red', 'grn', 'yel', 'blu', 'mag', 'cyn'):
            c = r[k] or r['fg']
            while contrast(c, r['bg']) < 4.5 and lum(c) < .9:
                c = mix(c, WHITE, .88)
            r[k] = c
    else:
        r['bg0'] = r['bg0'] or mix(bg, BLACK, .6)
        r['bg2'] = r['bg2'] or mix(bg, fg, .9)
        r['fgb'] = r['fgb'] or fg
        r['fg2'] = r['fg2'] or mix(fg, bg, .55)
        r['mut'] = r['mut'] or mix(fg, bg, .35)
        r['sel'] = r['sel'] or mix(bg, fg, .8)
        r['acc'] = r['acc'] or r['blu'] or fg
        for k in ('red', 'grn', 'yel', 'blu', 'mag', 'cyn'):
            r[k] = r[k] or r['acc']
    return mode, r


# ---------------------------------------------------------------- the rolodex
class Unavailable(Exception):
    """A rolodex theme that could not be brought here: not installed, and the fetch failed."""
    def __init__(self, msg, offline=False):
        super().__init__(msg)
        self.offline = offline  # the network, not this one repository, is what failed

NETWORK_DOWN = ('could not resolve host', 'failed to connect', 'network is unreachable',
                'connection timed out', 'timed out after')

def rolodex(path=None):
    """{name: (git url or None, path inside the repository or '')}, or None when there is no file.

    A line is `name source [path]  # note`; a source of "-" means installed here only.
    """
    path = path or ROLODEX
    if not os.path.isfile(path):
        return None
    entries = {}
    with open(path, encoding='utf-8') as f:
        lines = f.read().splitlines()
    for line in lines:
        parts = line.split('#', 1)[0].split()
        if not parts:
            continue
        src = parts[1] if len(parts) > 1 and parts[1] != '-' else None
        if src and '://' not in src and not src.startswith('git@') and not os.path.isabs(src):
            src = f'https://github.com/{src}.git'
        entries[parts[0]] = (src, parts[2].strip('/') if len(parts) > 2 else '')
    return entries

def git(*args, cwd=None, text=True):
    env = {**os.environ, 'GIT_TERMINAL_PROMPT': '0'}  # a private or vanished repo fails, never prompts
    return subprocess.run(['git', *args], cwd=cwd, check=True, capture_output=True, text=text,
                          timeout=90, env=env).stdout

def write_atomic(path, data):
    tmp = f'{path}.{os.getpid()}.part'  # two builds fetching at once never share a half-written file
    with open(tmp, 'wb' if isinstance(data, bytes) else 'w') as f:
        f.write(data)
    os.replace(tmp, path)

def cached_theme(name):
    d = os.path.join(CACHE, name)
    return themes([CACHE]).get(name) if os.path.isdir(d) else None

def fetch(name, url, sub, rng):
    """One wallpaper of a rolodex theme, from the cache or else from its repository.

    Only colors.toml, the list of wallpaper names and the one wallpaper picked cross the
    network: the clone is bare, one commit deep and carries no file contents until asked.
    A wallpaper already in the cache is used without touching the network at all.
    """
    d = os.path.join(CACHE, name)
    bgdir, listing, colors = os.path.join(d, 'backgrounds'), os.path.join(d, 'wallpapers.txt'), os.path.join(d, 'colors.toml')
    names = Path(listing).read_text(encoding='utf-8').splitlines() if os.path.isfile(listing) else []
    choice = rng.choice(names) if names else None
    if choice and os.path.isfile(colors) and os.path.isfile(os.path.join(bgdir, choice)):
        return os.path.join(bgdir, choice)
    if not url:
        raise Unavailable(f'{name} is not installed here and the rolodex gives no source for it')
    prefix = sub + '/' if sub else ''
    try:
        with tempfile.TemporaryDirectory() as tmp:
            repo = os.path.join(tmp, 'r.git')
            git('clone', '--bare', '--quiet', '--depth', '1', '--filter=blob:none', url, repo)
            listed = [n for n in git('ls-tree', '-z', '--name-only', f'HEAD:{prefix}backgrounds', cwd=repo).split('\0')
                      if n.lower().endswith(IMAGE_EXT)]
            if not listed:
                raise Unavailable(f'{name}: {url} has no wallpapers in {prefix}backgrounds/')
            os.makedirs(bgdir, exist_ok=True)
            write_atomic(listing, ''.join(n + '\n' for n in listed))
            if choice not in listed:
                choice = rng.choice(listed)
            if not os.path.isfile(colors):
                write_atomic(colors, git('cat-file', 'blob', f'HEAD:{prefix}colors.toml', cwd=repo))
            target = os.path.join(bgdir, choice)
            if not os.path.isfile(target):
                write_atomic(target, git('cat-file', 'blob', f'HEAD:{prefix}backgrounds/{choice}', cwd=repo, text=False))
            return target
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired, FileNotFoundError) as e:
        why = (getattr(e, 'stderr', None) or str(e))
        why = why.decode(errors='replace') if isinstance(why, bytes) else why
        have = cached_theme(name)
        if have:  # offline, or the repository moved: a wallpaper already here still serves
            return rng.choice(have['images'])
        last = why.strip().splitlines()[-1] if why.strip() else 'git failed'
        raise Unavailable(f'{name}: could not fetch {url}: {last}',
                          offline=any(m in why.lower() for m in NETWORK_DOWN))

def prune(keep, cap_mb=None):
    """Keep the cache under its cap by dropping the wallpapers used longest ago, never `keep`."""
    cap = (CACHE_MB if cap_mb is None else cap_mb) * 1e6
    files = []
    for t in themes([CACHE]).values():
        files += [(os.path.getmtime(p), os.path.getsize(p), p) for p in t['images']]
    total = sum(f[1] for f in files)
    for _, size, p in sorted(files):
        if total <= cap:
            break
        if os.path.realpath(p) != os.path.realpath(keep):
            os.remove(p)
            total -= size
    return total

def draw(rng, pool, installed, warn=lambda m: print(m, file=sys.stderr)):
    """(theme, image): a theme from the rolodex, evenly, then one of its wallpapers.

    An installed theme is used from disk. Any other is fetched; if that fails the draw moves
    on, and once the network has failed it only considers themes already on this machine.
    """
    offline = False
    for name in rng.sample(sorted(pool), len(pool)):
        if name in installed:
            return installed[name], rng.choice(installed[name]['images'])
        url, sub = pool[name]
        if offline:
            have = cached_theme(name)
            if have:
                return have, rng.choice(have['images'])
            continue
        try:
            image = fetch(name, url, sub, rng)
        except Unavailable as e:
            warn(f'brief-wall: {e}; drawing again')
            offline = offline or e.offline
            continue
        os.utime(image)  # the cache drops what was used longest ago
        prune(image)
        return cached_theme(name), image
    if installed:
        warn('brief-wall: nothing on the rolodex could be reached; using an installed theme')
        name = rng.choice(sorted(installed))
        return installed[name], rng.choice(installed[name]['images'])
    raise Unavailable('nothing on the rolodex could be reached, and no Omarchy theme is installed')


# ---------------------------------------------------------------- the wallpaper
def vips(*args):
    subprocess.run(['vips', *args], check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)

def vips_out(*args):
    return subprocess.run(['vips', *args], check=True, capture_output=True, text=True).stdout.strip()

def encode(image, width, quality, tmp):
    out = os.path.join(tmp, 'wall.webp')
    vips('thumbnail', image, f'{out}[Q={quality},strip]', str(width), '--size', 'down')
    # The brightest tenth of the picture is what the text has to survive, measured after a
    # blur about the size of the one the page applies.
    grey = os.path.join(tmp, 'grey.v')
    vips('colourspace', out, grey, 'b-w')
    blurred = os.path.join(tmp, 'blur.v')
    vips('gaussblur', grey, blurred, '6')
    p90 = float(vips_out('percent', blurred, '90'))
    mean = float(vips_out('avg', grey))
    with open(out, 'rb') as f:
        data = f.read()
    return data, p90, mean


# ---------------------------------------------------------------- contrast
def settle(r, wall_p90):
    """Make the page read over the wall's bright tenth, keeping as much wall as possible.

    The order matters. A muted colour that sits on its own theme's ground (everforest,
    miasma) is the palette's problem, so it is lifted first; thickening the scrim for it
    would bury the wallpaper to fix something the wallpaper did not cause. Then the scrim
    may thicken a little, then the ink lightens, and only then does the scrim go further.
    """
    bright = (wall_p90,) * 3
    dim = lambda: mix(r['fg'], r['fg2'], .60)  # base.css derives --dim the same way
    scrim = SCRIM_START
    need = {'fg': BODY_MIN, 'fgb': BODY_MIN, 'dim': MUTED_MIN, 'acc': MUTED_MIN}
    def worst():
        g = mix(r['bg'], bright, scrim)
        return {'fg': contrast(r['fg'], g), 'fgb': contrast(r['fgb'], g),
                'dim': contrast(dim(), g), 'acc': contrast(r['acc'], g)}
    def failing():
        return any(v < need[k] for k, v in worst().items())
    lifted = []
    def lift(role, test, step):
        while test() and lum(r[role]) < .95:
            r[role] = mix(r[role], WHITE, step)
            if role not in lifted:
                lifted.append(role)

    # 1 · a muted ink that fails against the theme's own ground, before any wall is involved
    lift('fg2', lambda: contrast(dim(), r['bg']) < MUTED_MIN + 1.5, .85)
    # 2 · a little more scrim
    while failing() and scrim < SCRIM_SOFT:
        scrim = round(scrim + .01, 2)
    # 3 · lighter ink
    lift('fg', lambda: worst()['fg'] < need['fg'], .92)
    lift('fgb', lambda: worst()['fgb'] < need['fgb'], .92)
    lift('acc', lambda: worst()['acc'] < need['acc'], .9)
    lift('fg2', lambda: worst()['dim'] < need['dim'], .85)
    # 4 · whatever is left, the scrim pays for
    while failing() and scrim < SCRIM_MAX:
        scrim = round(scrim + .01, 2)
    return scrim, {k: round(v, 2) for k, v in worst().items()}, to_hex(dim()), lifted


# ---------------------------------------------------------------- output
def css_block(pick, r, scrim, dim, wall_b64, measured, lifted):
    label = f"{pick['theme']} · {os.path.basename(pick['image'])}"
    roles = '\n'.join(f'  --{k}: {to_hex(v)};' for k, v in r.items())
    note = (f"theme {pick['theme']} ({pick['mode']}{', turned dark' if pick['mode'] == 'light' else ''}), "
            f"wallpaper {os.path.basename(pick['image'])}\n"
            f"   scrim {scrim:.2f}; contrast over the wall's brightest tenth: "
            + ', '.join(f'{k} {v}:1' for k, v in measured.items())
            + (f"\n   lightened to clear it: {', '.join(lifted)}" if lifted else ''))
    return (f'<style id="brief-wall">\n'
            f'/* brief-wall — {note} */\n'
            f':root {{\n{roles}\n  --dim: {dim};\n  --scrim: {round(scrim * 100)}%;\n'
            f'  --wall-label: "wallpaper · {label}";\n'
            f'  --wall: url("data:image/webp;base64,{wall_b64}");\n}}\n</style>')

def list_draw(installed, pool):
    """Print the draw: every rolodex theme and where its wallpapers come from."""
    if pool is None:
        for t in installed.values():
            print(f"{t['name']:<20} {len(t['images']):>2}  {read_colors(t['colors']).get('mode', 'dark'):<5}  {t['dir']}")
        return
    cached = themes([CACHE])
    for name, (url, sub) in pool.items():
        t = installed.get(name) or cached.get(name)
        listing = os.path.join(CACHE, name, 'wallpapers.txt')
        if name in installed:
            where = f"installed, {len(t['images'])} wallpapers"
        elif t:
            total = len(Path(listing).read_text(encoding='utf-8').splitlines()) if os.path.isfile(listing) else '?'
            where = f"cached, {len(t['images'])} of {total} wallpapers"
        else:
            where = 'not fetched yet' if url else 'MISSING: not installed and no source'
        mode = read_colors(t['colors']).get('mode', 'dark') if t else ''
        print(f"{name:<26} {mode:<5}  {where:<26} {(url or '-') + (':' + sub if sub else '')}")
    left = sorted(set(installed) - set(pool))
    size = sum(os.path.getsize(p) for t in cached.values() for p in t['images']) / 1e6
    print(f"\n{len(pool)} themes in the draw, from {ROLODEX}")
    print(f"cache {size:.0f} MB of {CACHE_MB:.0f} MB at {CACHE}")
    if left:
        print(f"installed but not in the draw ({len(left)}): {' '.join(left)}")

def main():
    ap = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    ap.add_argument('--theme')
    ap.add_argument('--image')
    ap.add_argument('--seed', type=int)
    # The page blurs the wall, so 1600 px wide is sharper than anything the reader can see,
    # and it keeps a photographic wallpaper near 200 KB inside the file.
    ap.add_argument('--width', type=int, default=1600)
    ap.add_argument('--quality', type=int, default=55)
    ap.add_argument('--list', action='store_true')
    ap.add_argument('--json', action='store_true')
    ap.add_argument('--out')
    a = ap.parse_args()

    installed = themes()
    pool = rolodex()
    if a.list:
        return list_draw(installed, pool)
    if not installed and not pool:
        sys.exit('brief-wall: no Omarchy themes with backgrounds found under ' + ', '.join(THEME_ROOTS))
    rng = random.Random(a.seed)

    if a.image:
        image = os.path.realpath(a.image)
        known = {**themes([CACHE]), **installed}
        owner = next((t for t in known.values() if image.startswith(t['dir'] + os.sep)), None)
        if owner is None and not a.theme:
            sys.exit(f'brief-wall: {a.image} is not inside a theme; name the palette with --theme')
        theme = (known.get(a.theme) or sys.exit(f"brief-wall: no theme '{a.theme}' here — try --list")) if a.theme else owner
    else:
        try:
            if a.theme:  # named outright: any installed theme, or anything the rolodex can fetch
                if a.theme in installed:
                    theme = installed[a.theme]
                    image = rng.choice(theme['images'])
                elif pool and a.theme in pool:
                    image = fetch(a.theme, *pool[a.theme], rng)
                    os.utime(image)
                    prune(image)
                    theme = cached_theme(a.theme)
                else:
                    sys.exit(f"brief-wall: no theme '{a.theme}' — try --list")
            elif pool is None:  # no rolodex: every installed theme is in the draw
                theme = installed[rng.choice(sorted(installed))]
                image = rng.choice(theme['images'])
            else:
                theme, image = draw(rng, pool, installed)
        except Unavailable as e:
            sys.exit(f'brief-wall: {e}')

    mode, r = roles_for(read_colors(theme['colors']))
    try:
        with tempfile.TemporaryDirectory() as tmp:
            data, p90, mean = encode(image, a.width, a.quality, tmp)
    except FileNotFoundError:
        sys.exit('brief-wall: needs vips (libvips) on PATH — pacman -S libvips')
    except subprocess.CalledProcessError as e:
        sys.exit(f'brief-wall: vips failed on {image}: {e.stderr.decode(errors="replace").strip()[-300:]}')
    scrim, measured, dim, lifted = settle(r, p90)
    pick = {'theme': theme['name'], 'mode': mode, 'image': image}

    if a.json:
        print(json.dumps({**pick, 'bytes': len(data), 'wall_p90': round(p90, 1), 'wall_mean': round(mean, 1),
                          'scrim': scrim, 'contrast': measured, 'lifted': lifted, 'dim': dim,
                          'roles': {k: to_hex(v) for k, v in r.items()}}, indent=1))
        return
    block = css_block(pick, r, scrim, dim, base64.b64encode(data).decode(), measured, lifted)
    if a.out:
        with open(a.out, 'w', encoding='utf-8') as f:
            f.write(block + '\n')
        print(f"brief-wall: {pick['theme']} · {os.path.basename(image)} · {len(data) // 1024} KB · "
              f"scrim {scrim:.2f} · {a.out}", file=sys.stderr)
    else:
        print(block)

if __name__ == '__main__':
    main()

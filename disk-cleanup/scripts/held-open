#!/usr/bin/env python3
"""Exit 1 if any process has a file open, or stands, inside the given paths. Reads /proc, because lsof is not installed.

    held-open <path>...

Exit 2 if the scan could not see enough of the system to be believed; an empty answer from a blind scan is the failure
this exists to prevent. Root's processes are unreadable without sudo; agents and renderers run as this user.
"""
import os, sys

paths = [os.path.realpath(p) for p in sys.argv[1:]]
if not paths:
    sys.exit(__doc__)
readable = 0
held = []
for pid in filter(str.isdigit, os.listdir('/proc')):
    try:
        links = [os.readlink(f'/proc/{pid}/cwd')]
        for fd in os.listdir(f'/proc/{pid}/fd'):
            try:
                links.append(os.readlink(f'/proc/{pid}/fd/{fd}'))
            except OSError:
                pass
    except OSError:
        continue
    readable += 1
    for link in links:
        for path in paths:
            if link == path or link.startswith(path + '/'):
                held.append((pid, link))
if readable < 20:
    print(f'held-open: only {readable} processes readable; cannot say', file=sys.stderr)
    sys.exit(2)
for pid, link in held[:20]:
    print(f'{pid}\t{link}')
print(f'held-open: {len(held)} held, {readable} processes read', file=sys.stderr)
sys.exit(1 if held else 0)
